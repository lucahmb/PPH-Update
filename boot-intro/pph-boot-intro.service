[Unit]
Description=Luca's Projects Boot Intro
DefaultDependencies=no
After=local-fs.target systemd-user-sessions.service plymouth-start.service
Before=getty@tty1.service display-manager.service

[Service]
Type=oneshot
# Plymouth still holds the DRM master at this point (After=plymouth-start.service
# only waits for it to have started, not stopped) - hand control back the same
# way plymouth-quit.service itself does, before mpv tries to become DRM master.
ExecStartPre=-/usr/bin/plymouth quit
ExecStart=/usr/bin/mpv --no-config --fs --vo=drm --drm-connector=0.DSI-2 \
  --no-audio --really-quiet --no-terminal --osc=no \
  --input-vo-keyboard=no /opt/luca-boot-intro/intro.mp4
StandardInput=tty
StandardOutput=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=sysinit.target
